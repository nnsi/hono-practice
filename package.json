{
  "scripts": {
    "dev": "pnpm --filter actiko-backend --filter actiko-frontend --filter actiko-admin-frontend --parallel dev",
    "dev:api": "pnpm --filter actiko-backend dev",
    "dev:fe": "pnpm --filter actiko-frontend dev",
    "dev:admin": "pnpm --filter actiko-admin-frontend dev",
    "test": "vitest --disable-console-intercept",
    "test-once": "vitest run",
    "test-e2e": "vitest run --config vitest.e2e.config.ts",
    "test:widget-swift": "bash scripts/test-widget-swift.sh",
    "guard:backend": "node scripts/check-backend-rules.js",
    "guard:dates": "node scripts/check-date-rules.js",
    "guard:widget-schema": "node scripts/check-widget-schema.js",
    "ci-check": "pnpm run guard:backend && pnpm run guard:dates && pnpm run guard:widget-schema && node scripts/check-test-baseline.js && vitest run --reporter=dot && biome lint && pnpm run tsc",
    "tsc": "tsgo --noEmit && pnpm --filter actiko-admin-frontend typecheck && pnpm --filter actiko-mobile typecheck",
    "lint": "biome lint",
    "fix": "biome check . --write --unsafe",
    "deploy:stg": "wrangler deploy --env stg",
    "deploy:prod": "wrangler deploy --env production",
    "build-client-stg": "pnpm --filter actiko-frontend build-stg",
    "build-client": "pnpm --filter actiko-frontend build",
    "deploy:fe-stg": "cd apps/frontend && pnpm exec wrangler deploy --env stg",
    "deploy:fe-prod": "cd apps/frontend && pnpm exec wrangler deploy --env production",
    "build-admin": "pnpm --filter actiko-admin-frontend build",
    "build-admin-stg": "pnpm --filter actiko-admin-frontend build-stg",
    "deploy:admin-stg": "cd apps/admin-frontend && pnpm exec wrangler deploy --env stg",
    "deploy:admin-prod": "cd apps/admin-frontend && pnpm exec wrangler deploy --env production",
    "deploy:tail-stg": "cd apps/tail-worker && pnpm exec wrangler deploy --env stg",
    "deploy:tail-prod": "cd apps/tail-worker && pnpm exec wrangler deploy --env production",
    "env:setup": "node scripts/setup-ports.js",
    "db-generate": "drizzle-kit generate --config=infra/drizzle/drizzle.config.ts",
    "db-migrate": "drizzle-kit migrate --config=infra/drizzle/drizzle.config.ts",
    "db-seed": "tsx scripts/seed-dev-data.ts",
    "db-clean": "tsx scripts/clean-db.ts",
    "mobile:e2e:android:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile-e2e-android-windows.ps1",
    "mobile:e2e:server": "API_PORT=3536 tsx scripts/mobile-e2e-server.ts",
    "mobile:e2e:metro": "pnpm --filter actiko-mobile run start:e2e",
    "mobile:e2e:build": "bash scripts/mobile-e2e-build-ios.sh",
    "mobile:e2e:build:android": "bash scripts/mobile-e2e-build-android.sh",
    "mobile:e2e": "bash scripts/mobile-e2e-run.sh",
    "mobile:e2e:android": "bash scripts/mobile-e2e-run-android.sh",
    "gen-be": "node scripts/gen-be.js",
    "generate:api-reference": "tsx scripts/generate-api-reference.ts && biome check apps/frontend/src/components/api-reference/apiReferenceData.generated.ts --write --unsafe",
    "mobile": "pnpm --filter actiko-mobile",
    "knip": "knip --include files,dependencies,unlisted,binaries"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "lefthook",
      "workerd"
    ],
    "overrides": {
      "drizzle-orm>expo-sqlite": "-",
      "hono": "4.13.5",
      "jiti": "2.7.0",
      "miniflare>sharp": "-",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "esbuild@<0.25.0": "0.25.12",
      "node-forge@<1.4.0": "1.4.0",
      "diff@7": "8.0.3",
      "tar@7": "7.5.21",
      "minimatch@5": "5.1.8",
      "ajv@8": "8.18.0",
      "yaml@2": "2.8.3",
      "@xmldom/xmldom@<0.9.0": "0.8.15",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": "0.9.12",
      "uuid@>=7 <11": "11.1.1",
      "joi@17": "17.13.7",
      "ts-deepmerge@6": "8.0.0",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "fast-uri@3": "3.1.8",
      "postcss@8": "8.5.23",
      "undici@7": "7.29.1",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "nanoid@3": "3.3.18",
      "decode-uri-component@<0.5.0": "0.5.0",
      "browserslist@4": "4.28.7",
      "baseline-browser-mapping@2": "2.11.0",
      "smol-toml@1": "1.7.1",
      "image-size@1": "2.0.3",
      "moment@2": "2.31.0"
    },
    "patchedDependencies": {
      "react-native-css-interop@0.2.6": "patches/react-native-css-interop@0.2.6.patch",
      "query-string@7.1.3": "patches/query-string@7.1.3.patch",
      "eas-cli@24.8.0": "patches/eas-cli@24.8.0.patch",
      "metro@0.84.4": "patches/metro@0.84.4.patch"
    }
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@electric-sql/pglite": "^0.5.3",
    "@hono/node-server": "^2.0.10",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@typescript/native-preview": "7.0.0-dev.20260701.1",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.2",
    "eas-cli": "24.8.0",
    "jsdom": "^29.1.1",
    "knip": "^6.23.0",
    "lefthook": "^2.1.9",
    "miniflare": "4.20260630.0",
    "playwright": "^1.61.1",
    "postgres": "^3.4.9",
    "sharp": "^0.35.4",
    "ts-mockito": "^2.6.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.106.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@expo/plist": "^0.8.0"
  }
}
