# Copy to tmp/revenuecat.local.env (gitignored); replace both values locally.
RC_LAB_PASSWORD=replace-with-random-16-or-more-characters
REVENUECAT_WEBHOOK_AUTH_KEY=replace-with-random-32-or-more-characters
RC_LAB_API_PORT=3546
RC_LAB_WEBHOOK_PORT=3547
# For a dedicated physical test device on your LAN only: 0.0.0.0
RC_LAB_HOST=127.0.0.1

# Read-only RevenueCat REST v1 reconciliation; use this project SDK public key.
# Local Test Store only: test_ key. Production: platform-specific key.
REVENUECAT_API_KEY=
