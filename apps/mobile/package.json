{
  "name": "actiko-mobile",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:e2e": "EXPO_PUBLIC_E2E_MODE=1 EXPO_PUBLIC_API_URL_IOS=http://localhost:3536 EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:3536 expo start --dev-client --clear --port 8082",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eas": "dotenv -e .env -- eas",
    "e2e:smoke": "maestro test .maestro/smoke.yaml",
    "e2e:smoke:android": "maestro test .maestro/smoke.yaml",
    "e2e:smoke:ios": "maestro test .maestro/smoke.yaml",
    "export:release:ios": "expo export --platform ios --output-dir ../../dist-release-bundles/ios --clear",
    "export:release:android": "expo export --platform android --output-dir ../../dist-release-bundles/android --clear",
    "typecheck": "tsgo --noEmit",
    "lint": "biome lint ./src",
    "test-once": "pnpm --dir ../.. exec vitest run --config vitest.config.ts apps/mobile"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo/metro-runtime": "~57.0.3",
    "@expo/plist": "^0.8.0",
    "@packages/auth-client": "workspace:*",
    "@packages/domain": "workspace:*",
    "@packages/i18n": "workspace:*",
    "@packages/platform": "workspace:*",
    "@packages/sync-engine": "workspace:*",
    "@packages/types": "workspace:*",
    "@packages/utils": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "~12.0.1",
    "@tanstack/react-query": "^5.101.2",
    "dayjs": "^1.11.21",
    "expo": "~57.0.4",
    "expo-apple-authentication": "^57.0.0",
    "expo-auth-session": "~57.0.2",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.5",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-image-manipulator": "~57.0.2",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.2",
    "expo-localization": "^57.0.0",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.3",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.6",
    "expo-web-browser": "~57.0.0",
    "hono": "4.12.27",
    "lucide-react-native": "^1.23.0",
    "nativewind": "^4.2.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-marked": "^8.1.0",
    "react-native-purchases": "^9.15.2",
    "react-native-reanimated": "~4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "~15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "rn-emoji-keyboard": "^1.7.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "babel-preset-expo": "^57.0.1",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "~3.4.19",
    "@expo/dom-webview": "^57.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  }
}
