{
  "name": "actiko-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:e2e": "EXPO_PUBLIC_E2E_MODE=1 EXPO_PUBLIC_API_URL_IOS=http://localhost:3536 EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:3536 expo start --dev-client --clear --port 8082",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eas": "dotenv -e .env -- eas",
    "e2e:smoke": "maestro test .maestro/smoke.yaml",
    "e2e:smoke:android": "maestro test .maestro/smoke.yaml",
    "e2e:smoke:ios": "maestro test .maestro/smoke.yaml",
    "typecheck": "tsgo --noEmit",
    "lint": "biome lint ./src",
    "test-once": "pnpm --dir ../.. exec vitest run --config vitest.config.ts apps/mobile"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo/metro-runtime": "~55.0.11",
    "@expo/plist": "^0.5.4",
    "@packages/auth-client": "workspace:*",
    "@packages/domain": "workspace:*",
    "@packages/i18n": "workspace:*",
    "@packages/platform": "workspace:*",
    "@packages/sync-engine": "workspace:*",
    "@packages/types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "~11.5.2",
    "@react-navigation/bottom-tabs": "^7.18.5",
    "@tanstack/react-query": "^5.101.2",
    "dayjs": "^1.11.21",
    "expo": "~55.0.27",
    "expo-apple-authentication": "^55.0.14",
    "expo-auth-session": "~55.0.17",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.16",
    "expo-dev-client": "~55.0.36",
    "expo-document-picker": "~55.0.14",
    "expo-file-system": "~55.0.23",
    "expo-image-manipulator": "~55.0.18",
    "expo-image-picker": "~55.0.21",
    "expo-linking": "~55.0.16",
    "expo-localization": "^55.0.16",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.15",
    "expo-sharing": "~55.0.21",
    "expo-sqlite": "~55.0.17",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.25",
    "expo-web-browser": "~55.0.17",
    "hono": "4.12.27",
    "lucide-react-native": "~0.575.0",
    "nativewind": "^4.2.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-marked": "^8.1.0",
    "react-native-purchases": "^9.15.2",
    "react-native-reanimated": "~4.2.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "~15.15.5",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2",
    "rn-emoji-keyboard": "^1.7.0",
    "uuid": "^14.0.1"
